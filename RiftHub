local T = {
    Accent  = Color3.fromRGB(124, 108, 245),   -- venyx indigo
    Accent2 = Color3.fromRGB(150, 122, 250),
    BG      = Color3.fromRGB(20, 20, 26),       -- neutral dark
    Panel   = Color3.fromRGB(28, 28, 36),
    Panel2  = Color3.fromRGB(38, 38, 48),
    Stroke  = Color3.fromRGB(48, 48, 62),
    Txt     = Color3.fromRGB(236, 237, 243),
    TxtDim  = Color3.fromRGB(138, 140, 156),
    Track   = Color3.fromRGB(52, 52, 66),
    Bad     = Color3.fromRGB(235, 110, 120),
}
local QUAD = TweenInfo.new(0.16, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
local function tween(o, p) TweenService:Create(o, QUAD, p):Play() end
local function corner(o, r) local c = Instance.new("UICorner", o); c.CornerRadius = UDim.new(0, r); return c end

-- paste your Rimuru decal/image id here (just the number, or rbxassetid://NUMBER)
-- catalog -> open the decal -> copy the id from the URL. leave as-is to hide the bg.
local RIMURU_ID = "rbxassetid://0"

