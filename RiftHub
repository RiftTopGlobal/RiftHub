    for _, p in ipairs(Players:GetPlayers()) do if p.Character then set[p.Character] = true end end
    return set
end

-- find every alive NPC model anywhere in the workspace (no folder assumption)
local function findEnemies()
    local out = {}
    local chars = playerChars()
    local seen = {}
    local function add(m, hum)
        if seen[m] then return end
        local root = m:FindFirstChild("HumanoidRootPart") or m.PrimaryPart
        if root and hum and hum.Health > 0 then
            seen[m] = true
            out[#out+1] = { model = m, root = root }
        end
    end
    -- fast path: known containers
    local known = workspace:FindFirstChild("Enemies") or workspace:FindFirstChild("NPCs")
        or workspace:FindFirstChild("Mobs") or workspace:FindFirstChild("Monsters")
    if known then
        for _, m in ipairs(known:GetChildren()) do
            if m:IsA("Model") and not chars[m] then add(m, m:FindFirstChildOfClass("Humanoid")) end
        end
    end
    -- fallback: sweep the whole workspace for NPC humanoids
    if #out == 0 then
        for _, d in ipairs(workspace:GetDescendants()) do
            if d:IsA("Humanoid") then
                local m = d.Parent
                if m and m:IsA("Model") and not chars[m] and m ~= lp.Character then add(m, d) end
            end
        end
    end
    return out
end

-- cached list (models), refreshed periodically; positions read live
local enemyList, enemyTime = {}, 0
local function getEnemies()
    if tick() - enemyTime > 0.4 then enemyList = findEnemies(); enemyTime = tick() end
    return enemyList
end

-- nearest alive enemy root within range, optional name filter (substring)
local function nearestEnemy(fromPos, range, nameFilter)
    local best, bestD = nil, range
    for _, e in ipairs(getEnemies()) do
        local m, root = e.model, e.root
        if m and m.Parent and root and root.Parent then
            local hum = m:FindFirstChildOfClass("Humanoid")
            if hum and hum.Health > 0 then
                local matches = (not nameFilter) or nameFilter == "All Mobs"
                    or string.find(string.lower(m.Name), string.lower(nameFilter), 1, true) ~= nil
                if matches then
                    local d = (root.Position - fromPos).Magnitude
                    if d < bestD then bestD = d; best = root end
                end
            end
        end
    end
    return best
end

