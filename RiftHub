--============================================================================
local FV4 = { on = false, tweenSpeed = 120 }   -- studs/sec
local SHIP_CF = CFrame.new(918.576, 125.098, 32851.527)  -- haunted ship inside
local GATE_CF = CFrame.new(-12463, 376, -7567)           -- mansion gate (outside)
local CAFE_CF = CFrame.new(-12463, 376, -7540)           -- through the gate / cafe (adjust!)

-- best-effort V4 check; returns false if unknown so the farm just keeps running
local function hasV4()
    return false
end

local function fv4Attack()
    if not (RegisterAttack and RegisterHit) then return end
    local hrp = getHRP()
    if not hrp then return end
    local targets = {}
    for _, e in ipairs(getEnemies()) do
        local m, root = e.model, e.root
        local head = m and m:FindFirstChild("Head")
        if head and root and (root.Position - hrp.Position).Magnitude <= 5000 then
            targets[#targets+1] = { m, head }
        end
    end
