-- Rift Hub loader
local SUPABASE_URL = "https://nmlyrklgdnjajowsapte.supabase.co"
local SUPABASE_KEY = "sb_publishable_5SexwDaSZQAVyiveuYg3JA_23kfYu6g"

local lp = game:GetService("Players").LocalPlayer
local HttpService = game:GetService("HttpService")

local url = SUPABASE_URL .. "/rest/v1/RiftHub?user_id=eq." .. lp.UserId .. "&select=script_code"
local ok, resp = pcall(function()
    return request({
        Url = url,
        Method = "GET",
        Headers = {
            ["apikey"]        = SUPABASE_KEY,
            ["Authorization"] = "Bearer " .. SUPABASE_KEY,
            ["Accept"]        = "application/json",
        },
    })
end)
if not ok or not resp then warn("Rift Hub: request failed"); return end
if resp.StatusCode ~= 200 then warn("Rift Hub: HTTP " .. tostring(resp.StatusCode) .. " - " .. tostring(resp.Body)); return end

local data = HttpService:JSONDecode(resp.Body)
if type(data) ~= "table" or #data == 0 then
    warn("Rift Hub: user " .. lp.UserId .. " not whitelisted")
    return
end
loadstring(data[1].script_code)()
