local HttpService = game:GetService("HttpService")
local LocalPlayer = game:GetService("Players").LocalPlayer

-- Supabase Configuration
local SUPABASE_URL = "https://nmlyrklgdnjajowsapte.supabase.co"
local SUPABASE_KEY = "sb_publishable_5SexwDaSZQAVyiveuYg3JA_23kfYu6g"

-- Query Supabase to check if the running user's ID is whitelisted
local url = SUPABASE_URL .. "/rest/v1/RiftHub?user_id=eq." .. tostring(LocalPlayer.UserId) .. "&select=script_code"

-- Detect available HTTP request function in the executor
local requestFunc = (syn and syn.request) or (http and http.request) or request or http_request

if not requestFunc then
    error("[RJR] 没有 هذا 脚本", 0)
end

-- Make request to Supabase API
local response = requestFunc({
    Url = url,
    Method = "GET",
    Headers = {
        ["apikey"] = SUPABASE_KEY,
        ["Authorization"] = "Bearer " .. SUPABASE_KEY,
        ["Content-Type"] = "application/json"
    }
})

if response and response.Success then
    local data = HttpService:JSONDecode(response.Body)
    
    -- Check if user is whitelisted and script code exists
    if #data > 0 and data[1].script_code then
        local loadFunc, err = loadstring(data[1].script_code)
        if loadFunc then
            loadFunc()
        else
            error("[RJR] 没有 هذا 脚本", 0)
        end
    else
        -- User ID is not in the whitelist table
        error("[RJR] 没有 هذا 脚本", 0)
    end
else
    error("[RJR] 没有 هذا 脚本", 0)
end
