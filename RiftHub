    local dist = (goal.Position - hrp.Position).Magnitude
    if activeTween then activeTween:Cancel() end
    activeTween = TweenService:Create(hrp, TweenInfo.new(dist / PL.speed, Enum.EasingStyle.Linear), { CFrame = goal })
    activeTween:Play()
    task.delay(0.05, function() if hum then hum:ChangeState(Enum.HumanoidStateType.Running) end end)
end

