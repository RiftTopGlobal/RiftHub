local Library = {}
Library.__index = Library

function Library.new(title)
    local self = setmetatable({}, Library)
    self.tabs       = {}
    self.activePage = nil
    self.activeBtn  = nil

    local gui = Instance.new("ScreenGui")
    gui.Name = "uwuHub"; gui.ResetOnSpawn = false
    gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    if typeof(protectgui) == "function" then protectgui(gui) end
    gui.Parent = lp:WaitForChild("PlayerGui")
    self.gui = gui

    local root = Instance.new("Frame", gui)
    root.Size = UDim2.new(0, 470, 0, 340); root.Position = UDim2.new(0.5, -235, 0.5, -170)
    root.BackgroundColor3 = T.BG; root.BorderSizePixel = 0
    corner(root, 12)
    local rs = Instance.new("UIStroke", root); rs.Color = T.Stroke; rs.Thickness = 1; rs.Transparency = 0.2
    self.root = root

    local shadow = Instance.new("ImageLabel", root)
    shadow.BackgroundTransparency = 1; shadow.ZIndex = 0
    shadow.Image = "rbxassetid://1316045217"; shadow.ImageColor3 = Color3.fromRGB(0,0,0); shadow.ImageTransparency = 0.45
    shadow.ScaleType = Enum.ScaleType.Slice; shadow.SliceCenter = Rect.new(10,10,118,118)
    shadow.Size = UDim2.new(1, 40, 1, 40); shadow.Position = UDim2.new(0, -20, 0, -20)

    -- background layer: clipped to the rounded panel, holds Rimuru + a color wash
    local bgHolder = Instance.new("Frame", root)
    bgHolder.Size = UDim2.new(1, 0, 1, 0); bgHolder.BackgroundTransparency = 1
    bgHolder.ClipsDescendants = true; bgHolder.ZIndex = 0
    corner(bgHolder, 12)
    self.bgHolder = bgHolder

    local rimuru = Instance.new("ImageLabel", bgHolder)
    rimuru.BackgroundTransparency = 1; rimuru.ZIndex = 0
    rimuru.Image = RIMURU_ID; rimuru.ImageTransparency = 0.82
    rimuru.ScaleType = Enum.ScaleType.Crop
    rimuru.AnchorPoint = Vector2.new(1, 1)
    rimuru.Size = UDim2.new(0, 230, 1, 20); rimuru.Position = UDim2.new(1, 10, 1, 10)
    self.rimuru = rimuru

    -- accent wash over the art so text stays readable
    local wash = Instance.new("Frame", bgHolder)
    wash.Size = UDim2.new(1,0,1,0); wash.BackgroundColor3 = T.BG; wash.BackgroundTransparency = 0.25
    wash.BorderSizePixel = 0; wash.ZIndex = 0
    local wgrad = Instance.new("UIGradient", wash)
    wgrad.Rotation = 0
    wgrad.Transparency = NumberSequence.new({
        NumberSequenceKeypoint.new(0, 0.1),
        NumberSequenceKeypoint.new(0.55, 0.45),
        NumberSequenceKeypoint.new(1, 0.75),
    })

    -- header
    local header = Instance.new("Frame", root)
    header.Size = UDim2.new(1, 0, 0, 44); header.BackgroundColor3 = T.Panel; header.BorderSizePixel = 0; header.ZIndex = 2
    corner(header, 12)
    local hcov = Instance.new("Frame", header)
    hcov.Size = UDim2.new(1,0,0.5,0); hcov.Position = UDim2.new(0,0,0.5,0); hcov.BackgroundColor3 = T.Panel; hcov.BorderSizePixel = 0; hcov.ZIndex = 1
    -- single hairline accent under the header
    local hline = Instance.new("Frame", header)
    hline.Size = UDim2.new(1, 0, 0, 1); hline.Position = UDim2.new(0, 0, 1, -1)
    hline.BackgroundColor3 = T.Accent; hline.BorderSizePixel = 0; hline.ZIndex = 3
    local hlg = Instance.new("UIGradient", hline)
    hlg.Color = ColorSequence.new(T.Accent, T.Accent2)
    hlg.Transparency = NumberSequence.new({
        NumberSequenceKeypoint.new(0, 0.2), NumberSequenceKeypoint.new(1, 0.9),
    })

    -- small accent tick + plain title
    local tick = Instance.new("Frame", header)
    tick.Size = UDim2.new(0, 3, 0, 16); tick.Position = UDim2.new(0, 14, 0.5, -8)
    tick.BackgroundColor3 = T.Accent; tick.BorderSizePixel = 0; tick.ZIndex = 3

    local tl = Instance.new("TextLabel", header)
    tl.Size = UDim2.new(0, 90, 1, 0); tl.Position = UDim2.new(0, 24, 0, 0); tl.BackgroundTransparency = 1
    tl.TextXAlignment = Enum.TextXAlignment.Left; tl.Text = title; tl.TextColor3 = T.Txt
    tl.TextSize = 14; tl.Font = Enum.Font.GothamBold; tl.ZIndex = 3

    local crumb = Instance.new("TextLabel", header)
    crumb.Size = UDim2.new(0, 160, 1, 0); crumb.Position = UDim2.new(0, 118, 0, 0); crumb.BackgroundTransparency = 1
    crumb.TextXAlignment = Enum.TextXAlignment.Left; crumb.Text = "/  Blox Fruits"; crumb.TextColor3 = T.TxtDim
    crumb.TextSize = 12; crumb.Font = Enum.Font.Gotham; crumb.ZIndex = 3

    -- window controls
    local function ctrlBtn(xOff, glyph, hoverColor)
        local b = Instance.new("TextButton", header)
        b.Size = UDim2.new(0, 24, 0, 24); b.Position = UDim2.new(1, xOff, 0.5, -12)
        b.BackgroundColor3 = T.Panel2; b.BackgroundTransparency = 1; b.BorderSizePixel = 0
        b.AutoButtonColor = false; b.Text = glyph; b.TextColor3 = T.TxtDim
        b.TextSize = 15; b.Font = Enum.Font.GothamBold; b.ZIndex = 4
        corner(b, 6)
        b.MouseEnter:Connect(function() tween(b, {BackgroundTransparency = 0, TextColor3 = hoverColor}) end)
        b.MouseLeave:Connect(function() tween(b, {BackgroundTransparency = 1, TextColor3 = T.TxtDim}) end)
        return b
    end
    local minBtn   = ctrlBtn(-58, "–", T.Txt)
    local closeBtn = ctrlBtn(-30, "✕", T.Bad)

    self.minimized = false
    local function setMin(v)
        self.minimized = v
        tween(root, {Size = v and UDim2.new(0, 470, 0, 44) or UDim2.new(0, 470, 0, 340)})
        for _, o in ipairs({self.side, self.content, self.statusbar, self.bgHolder}) do
            if o then o.Visible = not v end
        end
        minBtn.Text = v and "+" or "–"
    end
    minBtn.MouseButton1Click:Connect(function() setMin(not self.minimized) end)
    closeBtn.MouseButton1Click:Connect(function()
        if self.onClose then self.onClose() else self.gui:Destroy() end
    end)
    self.setMin = setMin

    -- sidebar (scrolls when there are more tabs than fit)
    local side = Instance.new("ScrollingFrame", root)
    side.Size = UDim2.new(0, 124, 1, -92); side.Position = UDim2.new(0, 10, 0, 50)
    side.BackgroundColor3 = T.Panel; side.BorderSizePixel = 0; side.ZIndex = 2
    side.ScrollBarThickness = 3; side.ScrollBarImageColor3 = T.Accent
    side.CanvasSize = UDim2.new(0,0,0,0); side.AutomaticCanvasSize = Enum.AutomaticSize.Y
    corner(side, 10)
    local sl = Instance.new("UIListLayout", side); sl.Padding = UDim.new(0, 6); sl.SortOrder = Enum.SortOrder.LayoutOrder
    local sp = Instance.new("UIPadding", side); sp.PaddingTop = UDim.new(0,8); sp.PaddingLeft = UDim.new(0,8); sp.PaddingRight = UDim.new(0,8); sp.PaddingBottom = UDim.new(0,8)
    self.side = side

    -- bottom status bar (executor style: attached · exploit · fps · user)
    local exName = "Potassium"
    pcall(function()
        if identifyexecutor then local n = identifyexecutor(); if n and #n > 0 then exName = n end end
    end)

    local bar = Instance.new("Frame", root)
    bar.Size = UDim2.new(1, -20, 0, 26); bar.Position = UDim2.new(0, 10, 1, -32)
    bar.BackgroundColor3 = T.Panel; bar.BorderSizePixel = 0; bar.ZIndex = 2
    corner(bar, 8)
    local bs = Instance.new("UIStroke", bar); bs.Color = T.Stroke; bs.Thickness = 1; bs.Transparency = 0.4
    self.statusbar = bar

    local sdot = Instance.new("Frame", bar)
    sdot.Size = UDim2.new(0, 7, 0, 7); sdot.Position = UDim2.new(0, 12, 0.5, -3.5)
    sdot.BackgroundColor3 = Color3.fromRGB(80, 220, 110); sdot.BorderSizePixel = 0; sdot.ZIndex = 3
    corner(sdot, 99)

    local sstat = Instance.new("TextLabel", bar)
    sstat.Size = UDim2.new(0.6, -28, 1, 0); sstat.Position = UDim2.new(0, 26, 0, 0); sstat.BackgroundTransparency = 1
    sstat.TextXAlignment = Enum.TextXAlignment.Left; sstat.Text = "Attached  ·  " .. exName
    sstat.TextColor3 = T.TxtDim; sstat.TextSize = 12; sstat.Font = Enum.Font.Code; sstat.ZIndex = 3

    local sfps = Instance.new("TextLabel", bar)
    sfps.Size = UDim2.new(0.4, -12, 1, 0); sfps.Position = UDim2.new(0.6, 0, 0, 0); sfps.BackgroundTransparency = 1
    sfps.TextXAlignment = Enum.TextXAlignment.Right; sfps.Text = "-- fps"
    sfps.TextColor3 = T.TxtDim; sfps.TextSize = 12; sfps.Font = Enum.Font.Code; sfps.ZIndex = 3

    -- live fps (guards against the gui being destroyed)
    local acc, frames = 0, 0
    RunService.RenderStepped:Connect(function(dt)
        if not bar.Parent then return end
        acc += dt; frames += 1
        if acc >= 0.5 then
            sfps.Text = math.floor(frames / acc + 0.5) .. " fps"
            acc, frames = 0, 0
        end
    end)

    -- content region
    local content = Instance.new("Frame", root)
    content.Size = UDim2.new(1, -148, 1, -92); content.Position = UDim2.new(0, 142, 0, 50)
    content.BackgroundTransparency = 1; content.ZIndex = 2
    self.content = content

    -- drag via header
    local dragging, dStart, sPos
    header.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true; dStart = i.Position; sPos = root.Position
        end
    end)
    UserInputService.InputChanged:Connect(function(i)
        if dragging and i.UserInputType == Enum.UserInputType.MouseMovement then
            local d = i.Position - dStart
            root.Position = UDim2.new(sPos.X.Scale, sPos.X.Offset + d.X, sPos.Y.Scale, sPos.Y.Offset + d.Y)
        end
    end)
    UserInputService.InputEnded:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 then dragging = false end
    end)

    return self
end

function Library:Tab(name)
    local btn = Instance.new("TextButton", self.side)
    btn.Size = UDim2.new(1, 0, 0, 32); btn.BackgroundColor3 = T.Panel2; btn.BackgroundTransparency = 1
    btn.BorderSizePixel = 0; btn.AutoButtonColor = false; btn.Text = name
    btn.TextColor3 = T.TxtDim; btn.TextSize = 13; btn.Font = Enum.Font.GothamMedium
    btn.TextXAlignment = Enum.TextXAlignment.Left; btn.ZIndex = 3
    corner(btn, 8)
    local pad = Instance.new("UIPadding", btn); pad.PaddingLeft = UDim.new(0, 14)

    local page = Instance.new("ScrollingFrame", self.content)
    page.Size = UDim2.new(1, 0, 1, 0); page.BackgroundTransparency = 1; page.BorderSizePixel = 0
    page.ScrollBarThickness = 3; page.ScrollBarImageColor3 = T.Accent; page.Visible = false
    page.CanvasSize = UDim2.new(0,0,0,0); page.AutomaticCanvasSize = Enum.AutomaticSize.Y; page.ZIndex = 2
    local pl = Instance.new("UIListLayout", page); pl.Padding = UDim.new(0, 6); pl.SortOrder = Enum.SortOrder.LayoutOrder
    local pp = Instance.new("UIPadding", page)
    pp.PaddingTop = UDim.new(0, 4); pp.PaddingLeft = UDim.new(0, 2); pp.PaddingRight = UDim.new(0, 10)
    local function slot() return page end  -- single clean column

    local function activate()
        if self.activePage then self.activePage.Visible = false end
        if self.activeBtn and self.activeBtn ~= btn then
            tween(self.activeBtn, {BackgroundTransparency = 1, TextColor3 = T.TxtDim})
            self.activeBtn.BackgroundColor3 = T.Panel2
        end
        page.Visible = true
        btn.BackgroundColor3 = T.Accent
        tween(btn, {BackgroundTransparency = 0, TextColor3 = Color3.fromRGB(255, 255, 255)})
        self.activePage, self.activeBtn = page, btn
    end
    btn.MouseButton1Click:Connect(activate)
    btn.MouseEnter:Connect(function()
        if self.activeBtn ~= btn then tween(btn, {BackgroundTransparency = 0.55, TextColor3 = T.Txt}) end
    end)
    btn.MouseLeave:Connect(function()
        if self.activeBtn ~= btn then tween(btn, {BackgroundTransparency = 1, TextColor3 = T.TxtDim}) end
    end)
    if not self.activePage then activate() end

    local tab = { page = page }

    -- Toggle: returns object with :Set(v) for external sync (keybinds etc.)
    function tab:Toggle(label, default, cb)
        local row = Instance.new("Frame", slot())
        row.Size = UDim2.new(1, 0, 0, 34); row.BackgroundColor3 = T.Panel; row.BorderSizePixel = 0; row.ZIndex = 2
        corner(row, 8)
        local st = Instance.new("UIStroke", row); st.Color = T.Stroke; st.Thickness = 1; st.Transparency = 0.55
        row.MouseEnter:Connect(function() tween(st, {Transparency = 0.15}); tween(row, {BackgroundColor3 = T.Panel2}) end)
        row.MouseLeave:Connect(function() tween(st, {Transparency = 0.55}); tween(row, {BackgroundColor3 = T.Panel}) end)
        local lbl = Instance.new("TextLabel", row)
        lbl.Size = UDim2.new(1, -60, 1, 0); lbl.Position = UDim2.new(0, 12, 0, 0); lbl.BackgroundTransparency = 1
        lbl.Text = label; lbl.TextColor3 = default and T.Txt or T.TxtDim; lbl.TextXAlignment = Enum.TextXAlignment.Left
        lbl.TextSize = 13; lbl.Font = Enum.Font.GothamMedium; lbl.ZIndex = 3

        local track = Instance.new("TextButton", row)
        track.Size = UDim2.new(0, 40, 0, 20); track.Position = UDim2.new(1, -50, 0.5, -10)
        track.BackgroundColor3 = default and T.Accent or T.Track; track.BorderSizePixel = 0
        track.AutoButtonColor = false; track.Text = ""; track.ZIndex = 3
        corner(track, 99)

        local knob = Instance.new("Frame", track)
        knob.Size = UDim2.new(0, 16, 0, 16)
        knob.Position = default and UDim2.new(1, -18, 0.5, -8) or UDim2.new(0, 2, 0.5, -8)
        knob.BackgroundColor3 = Color3.fromRGB(245,245,255); knob.BorderSizePixel = 0; knob.ZIndex = 4
        corner(knob, 99)

        local state = default
        local obj = {}
        function obj:Set(v, fire)
            state = v
            tween(track, {BackgroundColor3 = state and T.Accent or T.Track})
            tween(knob, {Position = state and UDim2.new(1,-18,0.5,-8) or UDim2.new(0,2,0.5,-8)})
            tween(lbl, {TextColor3 = state and T.Txt or T.TxtDim})
            if fire ~= false then cb(state) end
        end
        track.MouseButton1Click:Connect(function() obj:Set(not state) end)
        return obj
    end

    -- Slider: min/max/default numeric
    function tab:Slider(label, min, max, default, cb)
        local row = Instance.new("Frame", slot())
        row.Size = UDim2.new(1, 0, 0, 46); row.BackgroundColor3 = T.Panel; row.BorderSizePixel = 0; row.ZIndex = 2
        corner(row, 8)
        local st = Instance.new("UIStroke", row); st.Color = T.Stroke; st.Thickness = 1; st.Transparency = 0.55
        row.MouseEnter:Connect(function() tween(st, {Transparency = 0.15}) end)
        row.MouseLeave:Connect(function() tween(st, {Transparency = 0.55}) end)
        local lbl = Instance.new("TextLabel", row)
        lbl.Size = UDim2.new(1, -24, 0, 18); lbl.Position = UDim2.new(0, 12, 0, 6); lbl.BackgroundTransparency = 1
        lbl.Text = label; lbl.TextColor3 = T.Txt; lbl.TextXAlignment = Enum.TextXAlignment.Left
        lbl.TextSize = 13; lbl.Font = Enum.Font.GothamMedium; lbl.ZIndex = 3
        local val = Instance.new("TextLabel", row)
        val.Size = UDim2.new(0, 50, 0, 18); val.Position = UDim2.new(1, -62, 0, 6); val.BackgroundTransparency = 1
        val.Text = tostring(default); val.TextColor3 = T.Accent2; val.TextXAlignment = Enum.TextXAlignment.Right
        val.TextSize = 13; val.Font = Enum.Font.GothamBold; val.ZIndex = 3

        local bar = Instance.new("Frame", row)
        bar.Size = UDim2.new(1, -24, 0, 6); bar.Position = UDim2.new(0, 12, 1, -14); bar.BackgroundColor3 = T.Track
        bar.BorderSizePixel = 0; bar.ZIndex = 3
        corner(bar, 99)
        local fill = Instance.new("Frame", bar)
        fill.Size = UDim2.new((default-min)/(max-min), 0, 1, 0); fill.BackgroundColor3 = T.Accent; fill.BorderSizePixel = 0; fill.ZIndex = 4
        corner(fill, 99)

        local dragging = false
        local function setFromX(px)
            local rel = math.clamp((px - bar.AbsolutePosition.X) / bar.AbsoluteSize.X, 0, 1)
            local v = math.floor(min + (max - min) * rel + 0.5)
            fill.Size = UDim2.new(rel, 0, 1, 0)
            val.Text = tostring(v)
            cb(v)
        end
        bar.InputBegan:Connect(function(i)
            if i.UserInputType == Enum.UserInputType.MouseButton1 then dragging = true; setFromX(i.Position.X) end
        end)
        UserInputService.InputChanged:Connect(function(i)
            if dragging and i.UserInputType == Enum.UserInputType.MouseMovement then setFromX(i.Position.X) end
        end)
        UserInputService.InputEnded:Connect(function(i)
            if i.UserInputType == Enum.UserInputType.MouseButton1 then dragging = false end
        end)
    end

    function tab:Button(label, danger, cb)
        local btn2 = Instance.new("TextButton", slot())
        btn2.Size = UDim2.new(1, 0, 0, 32); btn2.BorderSizePixel = 0; btn2.AutoButtonColor = false
        btn2.BackgroundColor3 = danger and Color3.fromRGB(40,24,30) or T.Panel
        btn2.Text = label; btn2.TextColor3 = danger and T.Bad or T.Txt
        btn2.TextSize = 13; btn2.Font = Enum.Font.GothamBold; btn2.ZIndex = 3
        corner(btn2, 8)
        local st = Instance.new("UIStroke", btn2); st.Thickness = 1
        st.Color = danger and Color3.fromRGB(90,40,48) or T.Stroke; st.Transparency = danger and 0 or 0.4
        btn2.MouseButton1Click:Connect(cb)
        btn2.MouseEnter:Connect(function() tween(btn2, {BackgroundColor3 = danger and Color3.fromRGB(52,30,38) or T.Panel2}) end)
        btn2.MouseLeave:Connect(function() tween(btn2, {BackgroundColor3 = danger and Color3.fromRGB(40,24,30) or T.Panel}) end)
    end

    function tab:Label(text)
        local l = Instance.new("TextLabel", slot())
        l.Size = UDim2.new(1, 0, 0, 16); l.BackgroundTransparency = 1; l.Text = text
        l.TextColor3 = T.TxtDim; l.TextXAlignment = Enum.TextXAlignment.Left
        l.TextSize = 11; l.Font = Enum.Font.Gotham; l.ZIndex = 3
        return l
    end

    -- section header: uppercase dim label that groups the controls under it
    function tab:Section(text)
        local s = Instance.new("TextLabel", slot())
        s.Size = UDim2.new(1, 0, 0, 24); s.BackgroundTransparency = 1; s.Text = string.upper(text)
        s.TextColor3 = T.TxtDim; s.TextXAlignment = Enum.TextXAlignment.Left
        s.TextSize = 11; s.Font = Enum.Font.GothamBold; s.ZIndex = 3
        local p = Instance.new("UIPadding", s); p.PaddingTop = UDim.new(0, 8); p.PaddingLeft = UDim.new(0, 2)
    end

    -- Dropdown: expands inline; returns obj with :Set(v) and :Refresh(options)
    function tab:Dropdown(label, options, default, cb)
        local container = Instance.new("Frame", slot())
        container.Size = UDim2.new(1, 0, 0, 34); container.BackgroundTransparency = 1
        container.AutomaticSize = Enum.AutomaticSize.Y; container.ClipsDescendants = true; container.ZIndex = 2
        local cl = Instance.new("UIListLayout", container); cl.Padding = UDim.new(0, 4); cl.SortOrder = Enum.SortOrder.LayoutOrder

        local head = Instance.new("TextButton", container)
        head.Size = UDim2.new(1, 0, 0, 34); head.BackgroundColor3 = T.Panel; head.BorderSizePixel = 0
        head.AutoButtonColor = false; head.Text = ""; head.ZIndex = 3; head.LayoutOrder = 0
        corner(head, 8)
        local hst = Instance.new("UIStroke", head); hst.Color = T.Stroke; hst.Thickness = 1; hst.Transparency = 0.5
        local hl = Instance.new("TextLabel", head)
        hl.Size = UDim2.new(1, -40, 1, 0); hl.Position = UDim2.new(0, 12, 0, 0); hl.BackgroundTransparency = 1
        hl.Text = label .. ": " .. tostring(default or "—"); hl.TextColor3 = T.Txt
        hl.TextXAlignment = Enum.TextXAlignment.Left; hl.TextSize = 13; hl.Font = Enum.Font.GothamMedium; hl.ZIndex = 4
        local arw = Instance.new("TextLabel", head)
        arw.Size = UDim2.new(0, 24, 1, 0); arw.Position = UDim2.new(1, -28, 0, 0); arw.BackgroundTransparency = 1
        arw.Text = "▼"; arw.TextColor3 = T.TxtDim; arw.TextSize = 10; arw.Font = Enum.Font.GothamBold; arw.ZIndex = 4

        local listHolder = Instance.new("Frame", container)
        listHolder.Size = UDim2.new(1, 0, 0, 0); listHolder.BackgroundColor3 = T.Panel; listHolder.BorderSizePixel = 0
        listHolder.AutomaticSize = Enum.AutomaticSize.Y; listHolder.Visible = false; listHolder.ZIndex = 3; listHolder.LayoutOrder = 1
        corner(listHolder, 8)
        local inner = Instance.new("ScrollingFrame", listHolder)
        inner.Size = UDim2.new(1, 0, 0, 0); inner.AutomaticSize = Enum.AutomaticSize.Y; inner.BackgroundTransparency = 1
        inner.BorderSizePixel = 0; inner.ScrollBarThickness = 3; inner.ScrollBarImageColor3 = T.Accent; inner.ZIndex = 3
        local il = Instance.new("UIListLayout", inner); il.Padding = UDim.new(0, 2); il.SortOrder = Enum.SortOrder.LayoutOrder
