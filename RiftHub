local function unload()
    S.Enabled = false; FLY.on = false; UNLOADED = true; cachedTarget = nil
    AURA.on = false; ESP.on = false; FRUIT.on = false
    MOV.speed = false; MOV.jump = false
    PL.tween = false; PL.spectate = false; PL.insta = false
    HB.on = false; pcall(hbRestoreAll)
    FAST.on = false; HAKI.on = false; COLLECT.on = false; FV4.on = false; DRAGON.on = false
    MOVE2.noclip = false; MOVE2.infJump = false; MOVE2.cfSpeed = false; MOVE2.water = false
    VIS.fruitESP = false; VIS.chestESP = false; VIS.bossESP = false; VIS.tracers = false; VIS.fullbright = false
    pcall(function() setFullbright(false) end)
    pcall(function() if waterPlate then waterPlate:Destroy() end end)
    pcall(function() setRemLava(false) end)
    pcall(function() setLavaGod(false) end)
    pcall(function() for inst in pairs(worldCache) do clearWorld(inst) end end)
    pcall(function() for _, l in pairs(tracerCache) do l:Destroy() end end)
    MISC.dash = false; MISC.spin = false; MISC.removeAnim = false; MISC.unbreak = false; MISC.autoV4 = false
    pcall(stopFly)
    pcall(stopSpectate)
    pcall(function() setCollide(true) end)
    pcall(function() if antiStunConn then antiStunConn:Disconnect() end end)
    pcall(clearAllESP)
    pcall(function()
        local h = getHum()
        if h then h.WalkSpeed = 16; h.JumpPower = 50 end
    end)
    UserInputService.MouseIconEnabled = true
    for _, c in ipairs(conns) do pcall(function() c:Disconnect() end) end
    pcall(function() espGui:Destroy() end)
    pcall(function() Window.gui:Destroy() end)
    if typeof(getgenv) == "function" then getgenv().__uwu_unload = nil end
end
Misc:Button("Unload", true, unload)
Window.onClose = unload   -- header ✕ fully unloads
if typeof(getgenv) == "function" then getgenv().__uwu_unload = unload end

-- keybinds: RightAlt toggles aim, RightShift hides/shows the window
table.insert(conns, UserInputService.InputBegan:Connect(function(i, gpe)
    if gpe or UNLOADED then return end
    if i.KeyCode == S.ToggleKey then
        enabledToggle:Set(not S.Enabled)
    elseif i.KeyCode == Enum.KeyCode.RightShift then
        Window.root.Visible = not Window.root.Visible
    elseif i.KeyCode == Enum.KeyCode.Z then
        doBoost()
    end
end))

