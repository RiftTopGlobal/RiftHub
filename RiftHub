    if not hrp or not hum or not thrp then return end
    hrp.AssemblyLinearVelocity = Vector3.zero
    hum:ChangeState(Enum.HumanoidStateType.Physics)
    local predicted = thrp.Position + (thrp.AssemblyLinearVelocity * PL.pred)
