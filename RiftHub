            RegisterAttack:FireServer(0)
            RegisterHit:FireServer(targets[1][2], targets)
        end)
    end
end

-- tween HRP to a CFrame at FV4.tweenSpeed studs/sec
local function tweenTo(cf)
    local hrp = getHRP()
    local hum = getHum()
    if not hrp then return end
    if hum then hum:ChangeState(Enum.HumanoidStateType.Physics) end
    local dist = (cf.Position - hrp.Position).Magnitude
    local t = math.clamp(dist / FV4.tweenSpeed, 0.1, 40)
    local tw = TweenService:Create(hrp, TweenInfo.new(t, Enum.EasingStyle.Linear), { CFrame = cf })
    tw:Play()
    tw.Completed:Wait()
    if hrp then hrp.AssemblyLinearVelocity = Vector3.zero end
    if hum then hum:ChangeState(Enum.HumanoidStateType.GettingUp) end
end

local function startFV4()
    task.spawn(function()
        while FV4.on and not UNLOADED and not hasV4() do
            -- "go to the ship" = tween to wherever the mobs actually are
            local hrp = getHRP()
            local first = hrp and nearestEnemy(hrp.Position, 1e9, nil)
            if first then
                tweenTo(first.CFrame * CFrame.new(0, 4, 3))
            else
                tweenTo(SHIP_CF)                          -- fallback if none loaded
            end
            -- clear every NPC around the current spot, tweening to each
            while FV4.on and not UNLOADED do
                local h = getHRP()
                if not h then break end
                local tgt = nearestEnemy(h.Position, 800, nil)
                if not tgt then break end                -- area cleared
                tweenTo(tgt.CFrame * CFrame.new(0, 4, 3)) -- tween to the NPC
                for _ = 1, 6 do                           -- beat on it a moment
                    if not FV4.on then break end
                    fv4Attack(); task.wait(0.08)
                end
            end
            if not FV4.on or UNLOADED then break end
            tweenTo(GATE_CF)                             -- tween to the mansion gate
            task.wait(0.5)
            tweenTo(CAFE_CF)                             -- through the gate to the cafe
            task.wait(4)                                 -- pause to turn in
        end
    end)
end

